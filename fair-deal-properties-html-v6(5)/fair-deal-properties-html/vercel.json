{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/opportunities.html",
      "destination": "/marketplace.html",
      "permanent": true
    },
    {
      "source": "/inspect.html",
      "destination": "/inspections.html",
      "permanent": true
    },
    {
      "source": "/howitworks.html",
      "destination": "/how-it-works.html",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy-notice.html",
      "permanent": true
    },
    {
      "source": "/cookies.html",
      "destination": "/cookie-notice.html",
      "permanent": true
    },
    {
      "source": "/rights.html",
      "destination": "/data-rights.html",
      "permanent": true
    },
    {
      "source": "/home.html",
      "destination": "/index.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}

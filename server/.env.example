# ─── Server Environment Configuration ───────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MySQL Database connection (Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/fair_deal_db"

# JWT Authentication
JWT_SECRET=fdp-super-secure-jwt-secret-key-change-in-production-2026
JWT_EXPIRES_IN=7d

# Organization Mailboxes
FDP_ADMIN_EMAIL=info@fairdealng.com
FDP_DPO_EMAIL=dpo@fairdealng.com
FDP_INSPECTION_EMAIL=inspections@fairdealng.com

# Email provider: 'console' (logs to terminal) or 'smtp' (sends real email)
FDP_MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
EMAIL_FROM="Fair Deal Properties <no-reply@fairdealng.com>"

# Live Price Listener & Scraper (Default: every 6 hours)
SCRAPER_CRON_SCHEDULE="0 */6 * * *"

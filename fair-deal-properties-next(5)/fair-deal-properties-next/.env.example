# ─── Fair Deal Properties Ltd ───────────────────────────────────────────────
# Copy to .env.local and populate. Never commit .env.local.

# Public site origin. Drives canonical URLs, Open Graph tags, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.fairdealng.com

# Where form submissions are delivered. Separate addresses so that a data subject
# request is not buried in the general enquiry inbox - the NDPA 2023 thirty-day
# response clock runs from receipt.
FDP_ENQUIRY_INBOX=info@fairdealng.com
FDP_DPO_INBOX=info@fairdealng.com
FDP_INSPECTION_INBOX=info@fairdealng.com

# Transactional email provider. The notify adapter in src/lib/notify.ts is
# provider-agnostic: supply a key for whichever you contract.
FDP_MAIL_PROVIDER=console
FDP_MAIL_API_KEY=
FDP_MAIL_FROM="Fair Deal Properties <no-reply@fairdealng.com>"

# ─── Submission store ───────────────────────────────────────────────────────
# postgres : production. AWS RDS for PostgreSQL. See docs/aws-provisioning.md.
# file     : development only. No encryption at rest, does not survive a redeploy.
# none     : discards writes. For preview deployments that must not hold personal data.
FDP_STORE=file
FDP_STORE_DIR=.fdp-data

# From AWS Secrets Manager in production. Never commit a real value.
DATABASE_URL=
# Contents of the AWS RDS regional certificate bundle. The driver verifies the
# certificate and offers no option to disable that.
FDP_DB_CA=
FDP_DB_POOL_MAX=5

# Salt for the one-way hash of caller IP addresses. CHANGE THIS. A known salt makes
# the hashes reversible by anyone who reads the source, which turns a pseudonymisation
# measure into a stored IP address.
FDP_IP_SALT=

# Shared secret for POST /api/internal/retention-sweep. High entropy. The sweep refuses
# to run without it.
FDP_INTERNAL_SECRET=

# Simple fixed-window rate limit on public write endpoints.
FDP_RATE_LIMIT_WINDOW_MS=60000
FDP_RATE_LIMIT_MAX=8
